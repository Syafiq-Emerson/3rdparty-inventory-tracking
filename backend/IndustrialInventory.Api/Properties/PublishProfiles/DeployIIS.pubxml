<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>\\mynilasdmfgdb01\Automation\IndustrialInventory</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>

  <!-- Warn open browsers, show app_offline.htm while files are copied, then bring the site back. -->
  <PropertyGroup>
    <IndustrialInventoryNoticeSeconds Condition="'$(IndustrialInventoryNoticeSeconds)' == ''">30</IndustrialInventoryNoticeSeconds>
    <IndustrialInventoryNoticeMessage Condition="'$(IndustrialInventoryNoticeMessage)' == ''">Industrial Inventory is about to be updated. Save your work now; the app will be unavailable for a minute or two.</IndustrialInventoryNoticeMessage>
    <IndustrialInventoryOfflinePage>$(MSBuildThisFileDirectory)app_offline.htm</IndustrialInventoryOfflinePage>
    <!-- dotnet publish builds here first; the folder is emptied each time so files from older builds never reach the site. -->
    <PublishDir>$(MSBuildProjectDirectory)\bin\DeployIIS\</PublishDir>
  </PropertyGroup>

  <UsingTask TaskName="IndustrialInventoryDeployCountdown" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs">
        <![CDATA[
using System;
using System.Globalization;
using System.IO;
using System.Threading;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class IndustrialInventoryDeployCountdown : Task, ICancelableTask
{
    private readonly ManualResetEvent cancelled = new ManualResetEvent(false);

    [Required]
    public string NoticeFile { get; set; }

    public int Seconds { get; set; }

    public string Message { get; set; }

    public void Cancel()
    {
        cancelled.Set();
    }

    public override bool Execute()
    {
        var text = (Message ?? string.Empty).Replace('\r', ' ').Replace('\n', ' ').Trim();
        if (text.Length > 200) text = text.Substring(0, 200);
        var startsAt = DateTime.UtcNow.AddSeconds(Seconds);
        var json = "{\"startsAt\":\"" + startsAt.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture)
            + "\",\"message\":\"" + text.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"}";

        try
        {
            Directory.CreateDirectory(Path.GetDirectoryName(NoticeFile));
            var temp = NoticeFile + ".tmp";
            File.WriteAllText(temp, json);
            if (File.Exists(NoticeFile)) File.Delete(NoticeFile);
            File.Move(temp, NoticeFile);
        }
        catch (Exception ex) when (ex is IOException || ex is UnauthorizedAccessException)
        {
            Log.LogError("IndustrialInventory: could not write the update notice '{0}': {1} Check that your Windows account can write to the site folder.", NoticeFile, ex.Message);
            return false;
        }

        Log.LogMessage(MessageImportance.High, "IndustrialInventory: open pages now show a {0}-second update countdown. Cancel the publish now to call it off.", Seconds);
        var lastShown = -1;
        while (true)
        {
            var left = (int)Math.Ceiling((startsAt - DateTime.UtcNow).TotalSeconds);
            if (left <= 0) break;
            if (left != lastShown && (left % 10 == 0 || left <= 5))
            {
                Log.LogMessage(MessageImportance.High, "IndustrialInventory: site goes offline in {0} s...", left);
                lastShown = left;
            }
            if (cancelled.WaitOne(250))
            {
                try { File.Delete(NoticeFile); } catch (IOException) { } catch (UnauthorizedAccessException) { }
                Log.LogWarning("IndustrialInventory: publish cancelled during the countdown. The update banner has been removed and nothing was copied.");
                return false;
            }
        }

        Log.LogMessage(MessageImportance.High, "IndustrialInventory: countdown finished. Taking the site offline.");
        return true;
    }
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="IndustrialInventoryWaitForUnlock" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <TimeoutSeconds ParameterType="System.Int32" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Threading" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
if (File.Exists(FilePath))
{
    var deadline = DateTime.UtcNow.AddSeconds(TimeoutSeconds);
    var unlocked = false;
    while (!unlocked)
    {
        try
        {
            using (File.Open(FilePath, FileMode.Open, FileAccess.ReadWrite, FileShare.None)) { }
            unlocked = true;
        }
        catch (IOException)
        {
            if (DateTime.UtcNow >= deadline)
            {
                Log.LogError("IndustrialInventory: the site did not release '{0}' within {1} seconds. The update page stays up. Recycle the IndustrialInventory app pool and publish again.", FilePath, TimeoutSeconds);
                break;
            }
            Thread.Sleep(500);
        }
    }
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="IndustrialInventoryTakeSiteOffline" BeforeTargets="FileSystemPublish" Condition="'$(PublishUrl)' != ''">
    <PropertyGroup>
      <IndustrialInventorySiteDir>$([MSBuild]::EnsureTrailingSlash('$(PublishUrl)'))</IndustrialInventorySiteDir>
      <IndustrialInventoryNoticeFile>$(IndustrialInventorySiteDir)App_Data\deploy-notice.json</IndustrialInventoryNoticeFile>
    </PropertyGroup>

    <Error Condition="!Exists('$(IndustrialInventoryOfflinePage)')" Text="IndustrialInventory: '$(IndustrialInventoryOfflinePage)' is missing. Restore it from source control before publishing." />

    <IndustrialInventoryDeployCountdown Condition="'$(IndustrialInventoryNoticeSeconds)' != '0'"
                                        NoticeFile="$(IndustrialInventoryNoticeFile)"
                                        Seconds="$(IndustrialInventoryNoticeSeconds)"
                                        Message="$(IndustrialInventoryNoticeMessage)" />

    <Copy SourceFiles="$(IndustrialInventoryOfflinePage)" DestinationFolder="$(IndustrialInventorySiteDir)" />
    <Delete Files="$(IndustrialInventoryNoticeFile)" />
    <Message Importance="high" Text="IndustrialInventory: app_offline.htm is in place. Waiting for the app to stop..." />
    <IndustrialInventoryWaitForUnlock FilePath="$(IndustrialInventorySiteDir)IndustrialInventory.Api.dll" TimeoutSeconds="60" />

    <OnError ExecuteTargets="IndustrialInventoryClearNotice" />
  </Target>

  <Target Name="IndustrialInventoryClearNotice">
    <Delete Files="$(IndustrialInventoryNoticeFile)" ContinueOnError="true" />
    <Warning Condition="Exists('$(IndustrialInventorySiteDir)app_offline.htm')"
             Text="IndustrialInventory: publish failed, so the site stays on the update page. Fix the problem and publish again, or delete '$(IndustrialInventorySiteDir)app_offline.htm' to bring the old version back." />
  </Target>

  <Target Name="IndustrialInventoryBringSiteOnline" AfterTargets="FileSystemPublish" Condition="'$(PublishUrl)' != ''">
    <Delete Files="$(IndustrialInventorySiteDir)app_offline.htm" />
    <Message Importance="high" Text="IndustrialInventory: files copied and app_offline.htm removed. The site is back online." />
  </Target>

  <!--
    dotnet publish (the VS Code "publish" task) never runs FileSystemPublish for a folder profile; only Visual Studio does.
    So from the command line: empty the staging folder, publish into it, then run the same countdown → offline → copy → online steps.
  -->
  <Target Name="IndustrialInventoryCleanStaging" BeforeTargets="PrepareForPublish" Condition="'$(PublishUrl)' != '' And '$(DeployOnBuild)' != 'true'">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>

  <Target Name="IndustrialInventoryCopyToSite">
    <ItemGroup>
      <IndustrialInventoryStagedFile Include="$(PublishDir)**\*" />
    </ItemGroup>
    <Error Condition="'@(IndustrialInventoryStagedFile)' == ''" Text="IndustrialInventory: nothing was published to '$(PublishDir)', so nothing was copied. The site stays on the update page; publish again." />
    <Message Importance="high" Text="IndustrialInventory: copying @(IndustrialInventoryStagedFile->Count()) files to $(IndustrialInventorySiteDir)..." />
    <Copy SourceFiles="@(IndustrialInventoryStagedFile)"
          DestinationFiles="@(IndustrialInventoryStagedFile->'$(IndustrialInventorySiteDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Retries="5" RetryDelayMilliseconds="2000" />
    <OnError ExecuteTargets="IndustrialInventoryClearNotice" />
  </Target>

  <!-- After _DotNetCLIPostPublish so web.config has been written to the staging folder. -->
  <Target Name="IndustrialInventoryDeployFromCli" AfterTargets="_DotNetCLIPostPublish" Condition="'$(PublishUrl)' != '' And '$(DeployOnBuild)' != 'true'"
          DependsOnTargets="IndustrialInventoryTakeSiteOffline;IndustrialInventoryCopyToSite;IndustrialInventoryBringSiteOnline" />
</Project>
