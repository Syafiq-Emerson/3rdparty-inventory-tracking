{
  "version": "0.2.0",
  "configurations": [
    {
      // Starts the API and opens the app on :3000 once Kestrel is listening (after migrations).
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/IndustrialInventory.Api/bin/Debug/net10.0/IndustrialInventory.Api.dll",
      "cwd": "${workspaceFolder}/backend/IndustrialInventory.Api",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://\\S+",
        "uriFormat": "http://localhost:3000"
      },
      "presentation": {
        "group": "2-single",
        "order": 1
      }
    },
    {
      // Debug the API on its own. Swagger opens once Kestrel reports its address.
      "name": "Server (Swagger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/IndustrialInventory.Api/bin/Debug/net10.0/IndustrialInventory.Api.dll",
      "cwd": "${workspaceFolder}/backend/IndustrialInventory.Api",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "presentation": {
        "group": "2-single",
        "order": 2
      }
    },
    {
      // Vite dev server on :3000. It proxies /api to the backend, so both must be running.
      "name": "Vite",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "group": "2-single",
        "order": 3
      }
    },
    {
      // Attach to an already-running API (for example one started with `dotnet run`).
      "name": "Attach to Server",
      "type": "coreclr",
      "request": "attach",
      "processName": "IndustrialInventory.Api",
      "presentation": {
        "group": "2-single",
        "order": 4
      }
    }
  ],
  "compounds": [
    {
      // The usual way to run the app: API + client together, browser opens on :3000.
      "name": "Server + Vite",
      "configurations": ["Server", "Vite"],
      "stopAll": true,
      "presentation": {
        "group": "1-app",
        "order": 1
      }
    }
  ]
}
